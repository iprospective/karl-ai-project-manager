# OS
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-workspace

# Temporaires
*.tmp
*.bak
*.orig

# Python
__pycache__/
*.pyc
*.pyo

# Logs système (pas les .log.md des tâches)
*.log
!**/*.log.md

# Environnement local (credentials, URLs)
.env
# Config d'instance non-secrète scindée du .env (RM2438 T1) — chemins machine, non versionnable
pm.env

# Surcharge locale de pm.config.yml (chemins spécifiques machine)
pm.config.local.yml

# Projets — repo git séparé, cloné dans ce dossier
projects/

# Auto-référence du PM (symlink racine pointant vers lui-même via pm-ai-agents)
.mmi-pm

# Overrides d'instance du cockpit karl-agent (catalogues locaux : modèles par
# moteur, presets moniteurs) — propres à chaque machine, jamais versionnés.
deploy/karl-agent/cockpit/models.json
deploy/karl-agent/cockpit/monitors.json

# Réglages Claude Code du checkout — permissions et hooks propres à CHAQUE machine
# (les règles versionnées jusqu'ici portaient des chemins absolus de MathouDell,
# donc inapplicables ailleurs). Le fichier reste en place localement ; il sort
# simplement du suivi. ⚠ Au premier pull après ce changement, git SUPPRIME le
# fichier des autres checkouts — sauvegarder avant de déployer.
.claude/

# État runtime machine-local (compteur de session, registre branches/worktrees —
# RM2034). Présent dans l'arbre mais jamais versionné (par machine).
var/
