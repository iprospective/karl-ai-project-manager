#!/usr/bin/env bash
# mmi-pm — point d'entrée CLI unique du provisioning PM (Lot 1, RM1680).
#
# CDC : docs/cdc/2026-06-mmi-pm-cli.md. Décisions appliquées :
#   D3 — frontière sudo : re-exec sélectif (ops privilégiées → sudo, MOT DE PASSE requis,
#        pas de NOPASSWD). `--dry-run` prévisualise sans sudo.
#   D4 — dispatcher mince : route vers les `pm-*.py` existants quand pertinent.
# Self-locating : l'outil est la racine `bin/..` ; charge `.env` (PROJECTS_PATH, KARL_USER).
#
# Grammaire : mmi-pm <nom> <verbe> [args]   (nom = core|index|env|hooks|norms|client|project|list|doctor)

set -euo pipefail
shopt -s nullglob

ORIG_ARGS=("$@")
SELF="$(readlink -f "$0")"
CORE_DIR="$(dirname "$(dirname "$SELF")")"          # bin/.. = racine de l'outil
[ -f "$CORE_DIR/.env" ] && { set -a; . "$CORE_DIR/.env"; set +a; }
PROJECTS_PATH="${PROJECTS_PATH:-$CORE_DIR/projects}"
KARL_USER="${KARL_USER:-$(id -un)}"
KARL_SUDO_USER="${KARL_SUDO_USER:-root}"   # propriétaire + user des ops privilégiées (révision 2026-06-15)
WORKSPACES_ROOT="${WORKSPACES_ROOT:-/zfs/workspaces}"
DRY=0

die(){ echo "mmi-pm: $*" >&2; exit 1; }
log(){ echo "mmi-pm: $*"; }

usage(){ cat <<EOF
mmi-pm — provisioning PM (Lot 1)

  mmi-pm core update                 MAJ de l'outil déployé + re-verrouillage   [priv]
  mmi-pm index add <c>/<p> [path]    ajoute le lien d'index d'un projet         [index]
  mmi-pm index remove <c>/<p>        retire le lien d'index                      [index]
  mmi-pm index rebuild               reconstruit l'index depuis les emplacements [index]
                                     canoniques (.mmi-pm / .mmi-pm-client)
  mmi-pm env init [ws] [args…]       instancie le layout git d'un workspace      [karl]
                                     (repos/<r>.git + envs/<r>-dev ; --dry-run,
                                     --with-test, --teardown ; pm-env-init.py)
  mmi-pm env migrate [ws] [args…]    migre un workspace PRÉ-NORME → layout        [karl]
                                     (adoption in-place, snapshot ZFS, --dry-run ;
                                     pm-env-migrate.py)
  mmi-pm hooks install [args…]       (ré)installe les git-hooks PM               [karl]
                                     (post-commit, pre-push, pre-commit ;
                                     --repo <path> pour un seul repo ;
                                     pm-hooks-install.py)
  mmi-pm norms version               version NORMS courante (norms/VERSION)      [lecture]
  mmi-pm norms changes [args…]       delta NORMS entre versions                  [lecture]
                                     (--check <v> | --since <v> | --between A B ;
                                     pm-norms-changes.py)
  mmi-pm list                        inventaire de l'index                       [lecture]
  mmi-pm doctor [args…]              diagnostic (pm-doctor.py)                    [lecture]

Légende : [priv]=re-exec sudo ROOT  [index]=écrit projects/ (KARL_USER)  [lecture]=RO
Options : --dry-run (prévisualise les ops privilégiées sans sudo)
Env     : CORE_DIR=$CORE_DIR  PROJECTS_PATH=$PROJECTS_PATH
          KARL_USER=$KARL_USER  KARL_SUDO_USER=$KARL_SUDO_USER
EOF
}

# --- classification des sous-commandes (D3) ---
# Surface privilégiée minimale (décision RM1902, 2026-06-16) : SEUL `core update` mute la
# frontière de confiance (outil + normes), désormais ROOT-owned (verrou 3-couches RM2032)
# → re-exec sudo ROOT. Tout le reste tourne en KARL_USER (non privilégié) :
#   - `index *`         n'écrit que des symlinks dans projects/ (index karl-writable,
#                       régénérable, gitignored, pointant vers données karl) → rien à gater.
#   - `client/project *` (Lot 2) mutent la méta-structure karl co-localisée ; durcissement
#                       reporté (second temps) → pas de privilège pour l'instant.
is_privileged(){ # $1=nom $2=verbe
  case "${1:-} ${2:-}" in
    "core update") return 0;;
    *) return 1;;
  esac
}

# --- résolution <client>/<projet> ---
split_spec(){ # $1=<client>/<projet> -> globals CLIENT/PROJECT
  case "$1" in */*) :;; *) die "format attendu: <client>/<projet>";; esac
  CLIENT="${1%%/*}"; PROJECT="${1#*/}"
  [ -n "$CLIENT" ] && [ -n "$PROJECT" ] || die "format attendu: <client>/<projet>"
}

link_project(){ # $1=client $2=projet $3=loc(.../<projet>)
  local link="$PROJECTS_PATH/clients/$1/projects/$2"
  if [ "$DRY" = 1 ]; then echo "  [dry] $1/$2 -> $3/.mmi-pm"; return; fi
  mkdir -p "$(dirname "$link")"; ln -sfn "$3/.mmi-pm" "$link"
}

# ====================== commandes ======================

cmd_core_update(){
  [ "$(id -u)" -eq 0 ] || [ "$DRY" = 1 ] \
    || die "core update : doit tourner en root (sudo) — le code de l'instance est root-owned"
  [ -d "$CORE_DIR/.git" ] || [ -f "$CORE_DIR/.git" ] || die "$CORE_DIR n'est pas un dépôt git"
  # core update tourne en root sur un .git root-owned (après verrou) → `git` simple suffit
  # (owner == user). Garde anti « dubious ownership » si l'ownership diffère (transition) :
  # déclarer le repo sûr pour root, idempotent (pas le `-c` inline, fragile à l'expansion).
  if ! git config --global --get-all safe.directory 2>/dev/null | grep -qxF "$CORE_DIR"; then
    git config --global --add safe.directory "$CORE_DIR" 2>/dev/null || true
  fi
  local branch old; branch="$(git -C "$CORE_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  old="$(git -C "$CORE_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
  if [ "$DRY" = 1 ]; then
    log "[dry] git pull --ff-only origin $branch ; submodule update ; scripts/core-lock lock (re-verrou 3-couches, source unique) ; restart karl-agent si karl-agent.py modifié (RM2308) ; install pm-env-helper si modifié (RM2358)"
    return
  fi
  # ── Agent SSH éphémère (RM2239) : le remote passe par un ProxyJump (alias
  #    SSH) → même avec le multiplexing RM2069, la connexion unique coûte
  #    2 authentifications (hop + cible) = 2 passphrases sans agent. Un agent
  #    temporaire + un ssh-add unique = UNE saisie. `-t 120` : l'identité
  #    déchiffrée expire seule (filet si un chemin d'erreur saute le kill).
  #    Agent root déjà garni ⇒ on ne touche à rien (zéro prompt).
  local _agent_pid="" _agent_st=0
  ssh-add -l >/dev/null 2>&1 || _agent_st=$?   # garde set -e : code capté, pas fatal
  if [ "$_agent_st" -eq 1 ]; then          # agent joignable mais sans clé
    ssh-add -t 120 >/dev/null || true      # une saisie ; échec ⇒ comportement d'avant
  elif [ "$_agent_st" -gt 1 ]; then        # pas d'agent joignable
    local _agent_env
    if _agent_env="$(ssh-agent -s)"; then
      eval "$_agent_env" >/dev/null
      _agent_pid="${SSH_AGENT_PID:-}"
      ssh-add -t 120 >/dev/null || true    # une saisie ; échec ⇒ comportement d'avant
    fi
  fi
  # ── Multiplexing SSH (RM2069) : fetch + pull(refetch) + submodules partagent UNE
  #    connexion SSH → UNE seule passphrase (root via sudo n'a pas d'agent ; remote =
  #    alias SSH gitlab:). Master fermé + temp nettoyé en sortie. ControlPersist = filet
  #    en cas d'erreur. Zéro impact si un agent root existe (zéro prompt).
  local _cmdir _ghost; _cmdir="$(mktemp -d)"
  _ghost="$(git -C "$CORE_DIR" remote get-url origin 2>/dev/null | sed 's/:.*//')"
  export GIT_SSH_COMMAND="ssh -o ControlMaster=auto -o ControlPath=${_cmdir}/cm-%C -o ControlPersist=20s"
  git -C "$CORE_DIR" fetch --quiet origin
  git -C "$CORE_DIR" pull --ff-only origin "$branch"
  git -C "$CORE_DIR" submodule update --init --recursive 2>/dev/null || true
  ssh -o ControlPath="${_cmdir}/cm-%C" -O exit "$_ghost" 2>/dev/null || true
  rm -rf "$_cmdir" 2>/dev/null || true
  unset GIT_SSH_COMMAND
  # Fin de l'agent éphémère (RM2239) — uniquement s'il est à nous.
  if [ -n "$_agent_pid" ]; then
    ssh-agent -k >/dev/null 2>&1 || true
    unset SSH_AUTH_SOCK SSH_AGENT_PID
  fi
  local new; new="$(git -C "$CORE_DIR" rev-parse --short HEAD)"
  # Re-verrou : DÉLÉGUÉ à core-lock (SOURCE UNIQUE de la politique 3-couches). Le pull a pu
  # créer des fichiers root (on tourne en root) → core-lock réassigne code/.env/var/projects.
  [ -x "$CORE_DIR/scripts/core-lock" ] || die "scripts/core-lock absent/inexécutable"
  "$CORE_DIR/scripts/core-lock" lock "$CORE_DIR"
  # Hooks PM du core lui-même (RM2240) : son .git/hooks est root-owned → seule la
  # couche privilégiée peut les poser (pm-hooks-install les ignore avec un warn).
  local _hkdir="$CORE_DIR/.git/hooks" _pair _name _src
  mkdir -p "$_hkdir"
  for _pair in "post-commit=pm-post-commit.py" "pre-push=pm-pre-push" "pre-commit=pm-pre-commit.py"; do
    _name="${_pair%%=*}"; _src="$CORE_DIR/scripts/${_pair#*=}"
    [ -f "$_src" ] || continue
    if [ -e "$_hkdir/$_name" ] && [ ! -L "$_hkdir/$_name" ]; then
      log "hook $_name du core : fichier existant non-symlink → fusion manuelle"; continue
    fi
    ln -sfn "$_src" "$_hkdir/$_name"
  done
  log "hooks PM du core posés/rafraîchis (post-commit, pre-push, pre-commit)"
  # ── Services résidents (RM2308) : un démon garde l'ANCIEN code en mémoire tant
  #    qu'on ne le redémarre pas (vécu RM2303 : correctif déployé mais 403 fantôme,
  #    2 core update + une recette perdus avant diagnostic). Détection des fichiers
  #    de démons modifiés par le pull → restart du service USER (sûr par conception :
  #    KillMode=process, les sessions tmux survivent — RM1873), sinon signalement
  #    explicite. Les fichiers relus à chaque requête (cockpit/index.html, scripts
  #    pm-* invoqués à l'appel) ne nécessitent PAS de restart.
  if [ "$old" != "?" ] && [ "$old" != "$new" ]; then
    local _changed; _changed="$(git -C "$CORE_DIR" diff --name-only "$old" "$new" 2>/dev/null || true)"
    if printf '%s\n' "$_changed" | grep -qx "scripts/karl-agent.py"; then
      local _ku _uid; _ku="$(sed -n 's/^KARL_USER=//p' "$CORE_DIR/.env" 2>/dev/null | head -1)"
      _uid="$(id -u "${_ku:-__aucun__}" 2>/dev/null || true)"
      if [ -n "$_ku" ] && [ -n "$_uid" ] \
         && runuser -u "$_ku" -- env "XDG_RUNTIME_DIR=/run/user/$_uid" \
              systemctl --user is-active --quiet karl-agent.service 2>/dev/null; then
        if runuser -u "$_ku" -- env "XDG_RUNTIME_DIR=/run/user/$_uid" \
             systemctl --user restart karl-agent.service 2>/dev/null; then
          log "karl-agent.py modifié → karl-agent.service redémarré (KillMode=process : sessions tmux intactes)"
        else
          log "⚠ karl-agent.py modifié mais restart ÉCHOUÉ — l'agent sert l'ancien code ; relancer en tant que $_ku : systemctl --user restart karl-agent"
        fi
      else
        log "⚠ karl-agent.py modifié — service karl-agent inactif/introuvable ici ; si cette instance le fait tourner : systemctl --user restart karl-agent (user $_ku)"
      fi
    fi
  fi
  # ── Helper privilégié pm-env-helper (RM2358) : il vit HORS du repo
  #    (/usr/local/sbin, root:root) → son déploiement relève du même canal root
  #    que le code du core. Install idempotente : copie seulement si le contenu
  #    installé diffère du repo (source unique tools/env-runtime). Remplace le
  #    scp manuel du README (conservé comme bootstrap d'une box neuve).
  #    NB auto-update : ce bloc s'exécute depuis l'ANCIEN bin/mmi-pm — un helper
  #    fraîchement pullé est bien posé par CE run, mais une évolution de ce
  #    bloc lui-même ne prend effet qu'au run suivant.
  local _hsrc="$CORE_DIR/tools/env-runtime/pm-env-helper.sh" _hdst="/usr/local/sbin/pm-env-helper"
  if [ -f "$_hsrc" ] && ! cmp -s "$_hsrc" "$_hdst" 2>/dev/null; then
    install -o root -g root -m 755 "$_hsrc" "$_hdst"
    log "pm-env-helper déployé → $_hdst (source tools/env-runtime, RM2358)"
  fi
  log "outil $old -> $new ($branch) ; re-verrouillé via core-lock (politique 3-couches)"
  log "NB : pointeur de submodule du repo env NON committé automatiquement (geste séparé)."
}

cmd_index_add(){
  [ $# -ge 1 ] || die "usage: mmi-pm index add <client>/<projet> [path]"
  split_spec "$1"
  local loc="${2:-$WORKSPACES_ROOT/$CLIENT/$PROJECT}"
  [ -d "$loc/.mmi-pm" ] || die "pas de .mmi-pm dans $loc"
  link_project "$CLIENT" "$PROJECT" "$loc"
  log "index: $CLIENT/$PROJECT -> $loc/.mmi-pm"
}

cmd_index_remove(){
  [ $# -ge 1 ] || die "usage: mmi-pm index remove <client>/<projet>"
  split_spec "$1"
  local link="$PROJECTS_PATH/clients/$CLIENT/projects/$PROJECT"
  [ -L "$link" ] || die "pas de lien d'index pour $CLIENT/$PROJECT"
  if [ "$DRY" = 1 ]; then echo "  [dry] rm $link"; else rm "$link"; fi
  log "index: retiré $CLIENT/$PROJECT"
}

# Manifeste = meta.yml (RM1994 : plus de frontmatter dans overview.md).
# Discovery par `find` profondeur-agnostique (gère worm à iprospective/dev/Worm). Un `.mmi-pm`
# symlink (ancienne instance) n'est pas traversé par find sans -L → exclu automatiquement.
cmd_index_rebuild(){
  local np=0 nc=0 mf loc client slug sub clink
  log "reconstruction de l'index sous $PROJECTS_PATH (manifeste = meta.yml)"
  # --- niveau client : .../.mmi-pm-client/meta.yml ---
  while IFS= read -r mf; do
    [ -n "$mf" ] || continue
    loc="${mf%/.mmi-pm-client/meta.yml}"
    slug="$(awk '/^slug:/{print $2; exit}' "$mf" | tr -d '"')"
    slug="${slug:-$(basename "$loc")}"
    for sub in client memory projects_used; do
      [ -d "$loc/.mmi-pm-client/$sub" ] || continue
      clink="$PROJECTS_PATH/clients/$slug/$sub"
      if [ "$DRY" = 1 ]; then echo "  [dry] client $slug/$sub -> $loc/.mmi-pm-client/$sub"
      else mkdir -p "$(dirname "$clink")"; ln -sfn "$loc/.mmi-pm-client/$sub" "$clink"; fi
    done
    nc=$((nc+1))
  done < <(find "$WORKSPACES_ROOT" -maxdepth 6 -name .git -prune -o -type f -path '*/.mmi-pm-client/meta.yml' -print 2>/dev/null)
  # --- niveau projet : .../.mmi-pm/meta.yml ---
  while IFS= read -r mf; do
    [ -n "$mf" ] || continue
    loc="${mf%/.mmi-pm/meta.yml}"
    slug="$(awk '/^slug:/{print $2; exit}' "$mf" | tr -d '"')"
    client="$(awk '/^client:/{print $2; exit}' "$mf" | tr -d '"')"
    slug="${slug:-$(basename "$loc")}"
    client="${client:-$(basename "$(dirname "$loc")")}"
    link_project "$client" "$slug" "$loc"
    np=$((np+1))
  done < <(find "$WORKSPACES_ROOT" -maxdepth 6 -name .git -prune -o -type f -path '*/.mmi-pm/meta.yml' -print 2>/dev/null)
  log "index rebuild: $nc client(s), $np projet(s)$([ "$DRY" = 1 ] && echo ' [dry-run]')"
  return 0
}

cmd_list(){
  [ -d "$PROJECTS_PATH/clients" ] || die "index absent: $PROJECTS_PATH/clients"
  for cdir in "$PROJECTS_PATH"/clients/*/; do
    echo "$(basename "$cdir")"
    for p in "$cdir"projects/*; do
      [ -e "$p" ] || [ -L "$p" ] || continue
      printf '  └ %s' "$(basename "$p")"
      [ -L "$p" ] && printf ' -> %s' "$(readlink "$p")"
      echo
    done
  done
}

cmd_doctor(){ exec python3 "$CORE_DIR/scripts/pm-doctor.py" "$@"; }

# `hooks install` (RM2240) : pose les git-hooks PM (post-commit RM2035, pre-push
# RM2224, pre-commit RM2240) sur les repos PM + bares repos/*.git. Non privilégié
# (symlinks .git/hooks en KARL_USER ; le core privsep est signalé en warn).
cmd_hooks(){
  case "${1:-}" in
    install) shift; exec python3 "$CORE_DIR/scripts/pm-hooks-install.py" "$@";;
    *) die "hooks: verbe inconnu '${1:-}' (install)";;
  esac
}

# `norms version|changes` (RM2033) : lecture seule, version NORMS + delta de versions.
cmd_norms(){
  case "${1:-}" in
    version) exec python3 "$CORE_DIR/scripts/pm-norms-changes.py" --current;;
    changes) shift; exec python3 "$CORE_DIR/scripts/pm-norms-changes.py" "$@";;
    *) die "norms: verbe inconnu '${1:-}' (version|changes)";;
  esac
}

# `env init` (RM1947, P1a) : layout git d'un workspace. Non privilégié (git/fs en
# KARL_USER dans le workspace). --dry-run propagé tel quel à pm-env-init.
cmd_env(){
  # --dry-run est capté par le parsing global (→ $DRY, retiré des positionnels) :
  # on le réinjecte pour pm-env-init.
  local dry=(); [ "$DRY" = 1 ] && dry=(--dry-run)
  case "${1:-}" in
    init)    shift; exec python3 "$CORE_DIR/scripts/pm-env-init.py" "${dry[@]}" "$@";;
    migrate) shift; exec python3 "$CORE_DIR/scripts/pm-env-migrate.py" "${dry[@]}" "$@";;
    *) die "env: verbe inconnu '${1:-}' (init|migrate)";;
  esac
}

# ====================== parsing & dispatch ======================

# extrait --dry-run, garde le reste positionnel
POS=()
for a in "$@"; do case "$a" in --dry-run) DRY=1;; --help|-h) usage; exit 0;; *) POS+=("$a");; esac; done
set -- "${POS[@]:-}"
[ $# -ge 1 ] || { usage; exit 0; }

NOUN="${1:-}"; VERB="${2:-}"

# gate sudo : `core update` mute le code ROOT-owned (verrou 3-couches RM2032) → l'outil se
# RE-EXEC en ROOT tout seul (mot de passe requis), sauf en dry-run. Pas besoin de taper
# `sudo` à la main. (core update = seul verbe privilégié, cf. is_privileged.)
if is_privileged "$NOUN" "$VERB" && [ "$DRY" = 0 ] && [ "$(id -u)" -ne 0 ]; then
  log "opération privilégiée (code root-owned) → re-exec sudo (mot de passe requis)"
  exec sudo "$SELF" "${ORIG_ARGS[@]}"
fi

case "$NOUN" in
  core)  case "$VERB" in update) shift 2||true; cmd_core_update "$@";; *) die "core: verbe inconnu '$VERB' (update)";; esac;;
  index) shift 2||true
         case "$VERB" in
           add)     cmd_index_add "$@";;
           remove)  cmd_index_remove "$@";;
           rebuild) cmd_index_rebuild "$@";;
           *) die "index: verbe inconnu '$VERB' (add|remove|rebuild)";;
         esac;;
  env)    shift||true; cmd_env "$@";;
  hooks)  shift||true; cmd_hooks "$@";;
  norms)  shift||true; cmd_norms "$@";;
  list)   cmd_list;;
  doctor) shift||true; cmd_doctor "$@";;
  client|project) die "'$NOUN $VERB' = Lot 2 (pas encore implémenté)";;
  *) usage; exit 1;;
esac
