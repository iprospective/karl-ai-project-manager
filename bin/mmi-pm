#!/usr/bin/env bash
# mmi-pm — RELAIS vers le point d'entrée unique scripts/mmi-pm.py (RM3033 ; dans le PATH : /usr/local/bin/mmi-pm).
# Plus aucune logique ici : la grammaire historique `mmi-pm <nom> <verbe>` (core update, index add|remove|rebuild, list, env vhost,
# hooks install, norms version|changes, doctor) est résolue par le dispatcher (repli `pm-<nom>-<verbe>.py`).
# Ce fichier RESTE parce que c'est LE chemin que la règle sudoers autorise en root (`bin/mmi-pm core update*`,
# deploy/mmi-pm.sudoers.example) : pm-core-update.py se ré-exécute par `sudo <core>/bin/mmi-pm core update`.
set -euo pipefail
SELF="$(readlink -f "$0")"; CORE_DIR="$(dirname "$(dirname "$SELF")")"
case "${1:-}" in list) set -- index-list "${@:2}";; esac      # `mmi-pm list` (ancien) → `index-list`
exec python3 "$CORE_DIR/scripts/mmi-pm.py" "$@"
