#!/bin/bash
# Credential helper git → jeton GitHub, lu à la volée (RM3016) : d'abord le .env de
# l'utilisateur (~/.config/mmi-pm/.env — identité par dev, RM2497), sinon le .env de
# l'instance PM. Le secret ne transite jamais par un fichier de conf git ni un remote URL.
# Installation : cp … ~/.local/bin/ && chmod +x, puis
#   git config --global credential.https://github.com.helper ~/.local/bin/git-credential-pm-github
#   git config --global url.https://github.com/.insteadOf github:     # repli HTTPS+jeton de l'alias canonique
#   git config --global credential.https://github.com.useHttpPath true     # pour recevoir le chemin, donc l'organisation
# Clé par ORGANISATION (RM3016) : GITHUB__<OWNER>__TOKEN (owner slugifié en majuscules), sinon GITHUB_TOKEN.
[ "$1" = "get" ] || exit 0
owner=""
while IFS= read -r ligne; do case "$ligne" in path=*) owner="${ligne#path=}"; owner="${owner%%/*}";; esac; done
slug="$(printf '%s' "$owner" | tr -c 'A-Za-z0-9' '_' | tr 'a-z' 'A-Z')"
lire() { [ -r "$2" ] && sed -n "s/^$1=//p" "$2" | tr -d '"' | tr -d "'" | head -1; }
tok=""
for f in "${PM_USER_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/mmi-pm/.env}" /zfs/workspaces/.mmi-pm-core/.env; do
  [ -n "$slug" ] && [ -z "$tok" ] && tok="$(lire "GITHUB__${slug}__TOKEN" "$f")"
  [ -z "$tok" ] && tok="$(lire GITHUB_TOKEN "$f")"
  [ -n "$tok" ] && break
done
[ -n "$tok" ] || { echo "git-credential-pm-github : GITHUB__${slug:-<OWNER>}__TOKEN ou GITHUB_TOKEN absent (~/.config/mmi-pm/.env)" >&2; exit 1; }
echo "username=x-access-token"
echo "password=$tok"
