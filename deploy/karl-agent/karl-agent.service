[Unit]
Description=karl-agent — superviseur de sessions tmux d'agents karl-pm (RM1771)
Documentation=file:///zfs/workspaces/ai/project-management/agents/karl/karl-agent.md
After=network.target

[Service]
Type=simple
WorkingDirectory=/zfs/workspaces/ai/project-management
# Le PATH des services systemd USER n'inclut pas ~/.local/bin par défaut, or les
# moteurs (claude, opencode) y sont souvent installés. Sans ça, le tmux spawné
# lance une commande introuvable et la session meurt aussitôt. %h = home user.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Le daemon charge le .env du repo (KARL_AGENT_TOKEN, KARL_AGENT_PORT, …).
# Ne JAMAIS mettre de secret en clair dans cette unit (versionnée) :
# les variables sensibles vont dans /zfs/workspaces/ai/project-management/.env (gitignored).
ExecStart=/usr/bin/python3 /zfs/workspaces/ai/project-management/scripts/karl-agent.py
Restart=on-failure
RestartSec=2
# Le daemon bind 127.0.0.1 EN DUR (invariant sécu) — rien à durcir côté réseau ici.

[Install]
WantedBy=default.target
