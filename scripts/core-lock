#!/usr/bin/env bash
# core-lock — pose/retire le verrou de propriété 3-couches de .mmi-pm-core
#             (RM2032, couche core du modèle RM1902 ; cf. docs/cdc/2026-06-privsep-pm.md).
#
# SOURCE UNIQUE de la politique de propriété de l'instance déployée : provision-core
# (bootstrap one-time) et `mmi-pm core update` (déploiement) DÉLÈGUENT ici. Ne JAMAIS
# dupliquer le chown ailleurs.
#
# Modèle 3-couches — DÉCRIT dans scripts/pm_privsep.py (source unique, RM3379), résumé ici :
#   - CODE → root:root              : tout le versionné (bin/ scripts/ norms/ templates/
#       agents/ pm.*.yml .git …). L'agent runtime KARL_USER (mathieu) LIT/EXÉCUTE via les
#       bits « other » mais ne peut ni écrire ni committer l'instance (anti-pétouilles).
#   - .env → root:KARL_USER 640     : secrets dans la couche immuable (root) ; lus par le
#       groupe KARL_USER (mathieu, et mathieu-pm via son appartenance à ce groupe). SEUL
#       root les modifie.
#   - var/ → KARL_SUDO_USER:KARL_USER 2775 (setgid) : état runtime (var/sessions/…). Owner =
#       service PM (mathieu-pm) ; le groupe KARL_USER laisse l'agent écrire ; setgid → les
#       nouveaux fichiers héritent du groupe KARL_USER.
#   - projects/ → KARL_USER:KARL_USER : index résolveur régénérable (symlinks vers .mmi-pm
#       co-localisé, HORS frontière de confiance) → écrit sans privilège (mmi-pm index,
#       auto-commit ai-projects sous projects/.git). [CDC §8 « projects/ selon décision
#       finale » → tranché KARL_USER : l'index doit pouvoir s'écrire sans sudo.]
#
# Pré-requis système : KARL_SUDO_USER (mathieu-pm) DOIT être membre du groupe KARL_USER
# (mathieu) pour lire .env (640) et écrire var/ (groupe). Vérifié ci-dessous (avertissement).
#
# Usage : sudo core-lock <lock|unlock> [CORE_DIR] [--dry-run]
#   lock    : pose le verrou (déploiement / après MAJ).
#   unlock  : rend TOUT à KARL_USER (phases de dev/débogage de l'instance ; réversibilité).
set -euo pipefail

ACTION="${1:-}"; shift || true
CORE_DIR="$(dirname "$(dirname "$(readlink -f "$0")")")"   # RM3208/A2 : l'instance qui porte ce script (était figé sur /zfs/workspaces)
DRY=0
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1;;
    -*) echo "core-lock: option inconnue '$a'" >&2; exit 1;;
    *)  CORE_DIR="$a";;
  esac
done

die(){ echo "core-lock: $*" >&2; exit 1; }
run(){ if [ "$DRY" = 1 ]; then echo "  [dry] $*"; else "$@"; fi; }

case "$ACTION" in
  lock|unlock) :;;
  *) die "usage: core-lock <lock|unlock> [CORE_DIR] [--dry-run]";;
esac
[ "$DRY" = 1 ] || [ "$(id -u)" -eq 0 ] || die "root requis (chown vers/depuis root)"
[ -d "$CORE_DIR/.git" ] || [ -f "$CORE_DIR/.git" ] || die "$CORE_DIR n'est pas un checkout git"
[ -f "$CORE_DIR/.env" ] || die "$CORE_DIR/.env absent (secrets) — provisionner d'abord"

# Users lus dans le .env de l'instance (fédération) : KARL_USER = agent runtime (mathieu),
# KARL_SUDO_USER = service PM privilégié (mathieu-pm).
set -a; . "$CORE_DIR/.env"; set +a
: "${KARL_USER:?KARL_USER absent du .env}"
: "${KARL_SUDO_USER:?KARL_SUDO_USER absent du .env}"
id "$KARL_USER"      >/dev/null 2>&1 || die "user runtime '$KARL_USER' inexistant"
id "$KARL_SUDO_USER" >/dev/null 2>&1 || die "user PM '$KARL_SUDO_USER' inexistant"

# Modèle de propriété : SOURCE UNIQUE (scripts/pm_privsep.py, RM3379). Il n'est plus écrit en bash : deux
# déclarations divergeaient, et `pm-perms` corrigeait ce que la mise à jour suivante défaisait.
MODEL="$(python3 "$CORE_DIR/scripts/pm-privsep.py" --core "$CORE_DIR" --sh)" \
  || die "modèle de propriété illisible (scripts/pm-privsep.py)"
eval "$MODEL"
for i in 1 2 3; do eval "w=\${PRIVSEP_WARN_$i:-}"; [ -n "$w" ] && echo "core-lock: ⚠ $w" >&2; done
unset w

# Pré-requis d'appartenance : sans ça, le service PM n'écrit pas var/ et l'agent non plus.
for u in "$KARL_SUDO_USER" "$KARL_USER"; do
  if ! id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qx "$PRIVSEP_GROUP"; then
    echo "core-lock: ⚠ $u n'est PAS membre du groupe $PRIVSEP_GROUP" >&2
    echo "core-lock:   → corriger : sudo usermod -aG $PRIVSEP_GROUP $u" >&2
  fi
done
# Les SECRETS communs ne sont lisibles que par le groupe d'administration (décision RM3379/Q1).
if [ "$PRIVSEP_ADMIN_GROUP" != "$PRIVSEP_GROUP" ] \
   && ! id -nG "$KARL_SUDO_USER" 2>/dev/null | tr ' ' '\n' | grep -qx "$PRIVSEP_ADMIN_GROUP"; then
  echo "core-lock: ⚠ $KARL_SUDO_USER n'est pas dans $PRIVSEP_ADMIN_GROUP : les tâches de fond ne liront" >&2
  echo "core-lock:   pas les secrets communs. Corriger : sudo usermod -aG $PRIVSEP_ADMIN_GROUP $KARL_SUDO_USER" >&2
fi

if [ "$ACTION" = lock ]; then
  # 1) CODE → root (défaut pour tout). -RP : ne SUIT PAS les symlinks (index projects/ →
  #    .mmi-pm co-localisé) : on ne rechowne JAMAIS la donnée client pointée.
  run chown -RP root:root "$CORE_DIR"
  run chmod -R u=rwX,go=rX "$CORE_DIR"

  # 2) projects/ → service PM, groupe partagé, setgid : l'index est régénérable et s'écrit SANS privilège
  #    (mmi-pm index), par n'importe quel membre du groupe.
  run chown -RP "$PRIVSEP_SERVICE_USER:$PRIVSEP_GROUP" "$PRIVSEP_PROJECTS_DIR"
  run chmod -R u=rwX,g=rwX,o=rX "$PRIVSEP_PROJECTS_DIR"
  run find "$PRIVSEP_PROJECTS_DIR" -type d -exec chmod g+s {} +

  # 3) var/ → service PM : état runtime écrit par les comptes du groupe partagé (setgid → héritage).
  #    mkdir d'abord : sous racine root verrouillée, l'agent ne pourrait pas créer var/.
  run mkdir -p "$PRIVSEP_STATE_DIR"
  run chown -RP "$PRIVSEP_SERVICE_USER:$PRIVSEP_GROUP" "$PRIVSEP_STATE_DIR"
  run chmod -R u=rwX,g=rwX,o=rX "$PRIVSEP_STATE_DIR"
  run find "$PRIVSEP_STATE_DIR" -type d -exec chmod g+s {} +

  # 4) SECRETS communs (.env ET ses dérivés : sauvegardes comprises — RM3378) → root:<admin>, 640.
  #    Un dev n'a que sa conf personnelle (<core>/var/users/<login>/.env, RM3318).
  for f in $PRIVSEP_SECRET_FILES; do
    run chown root:"$PRIVSEP_ADMIN_GROUP" "$f"
    run chmod "$PRIVSEP_SECRET_MODE" "$f"
  done

  # 5) conf d'instance NON secrète (pm.env) → root:<groupe partagé>, 640 (elle était en 644).
  for f in $PRIVSEP_CONF_FILES; do
    [ -f "$f" ] || continue
    run chown root:"$PRIVSEP_GROUP" "$f"
    run chmod "$PRIVSEP_CONF_MODE" "$f"
  done

  echo "core-lock: $CORE_DIR VERROUILLÉ — $PRIVSEP_SUMMARY$([ "$DRY" = 1 ] && echo ' [dry-run]')"
else
  # unlock : TOUT → KARL_USER (dev/débogage de l'instance). Réversibilité complète du verrou.
  run chown -RP "$KARL_USER:$KARL_USER" "$CORE_DIR"
  run chmod -R u=rwX,go=rX "$CORE_DIR"
  echo "core-lock: $CORE_DIR DÉVERROUILLÉ — tout → $KARL_USER (dev/debug)$([ "$DRY" = 1 ] && echo ' [dry-run]')"
fi
