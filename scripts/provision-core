#!/usr/bin/env bash
# provision-core — bootstrap initial d'une instance .mmi-pm-core (one-time, ROOT requis).
#
# Geste one-time : (1) ajoute KARL_SUDO_USER au groupe KARL_USER, (2) reconstruit l'index,
# (3) pose le verrou de propriété 3-couches en DÉLÉGUANT à `scripts/core-lock` (source
# unique de la politique : code=root ; .env=root:KARL_USER ; var/=KARL_SUDO_USER:KARL_USER ;
# projects/=KARL_USER). Le chown inter-utilisateur exige root → ce geste NE passe PAS par
# `sudo -u KARL_SUDO_USER`. Les MAJ courantes passent ensuite par `sudo mmi-pm core update`
# (root, qui re-délègue à core-lock). RM2032 / RM1945 / RM1680.
#
# Pré-requis : .mmi-pm-core = checkout git provisionné, .env déjà placé (secrets),
# users KARL_USER / KARL_SUDO_USER existants.
#
# Usage : sudo provision-core [/zfs/workspaces/.mmi-pm-core]
set -euo pipefail

CORE_DIR="${1:-/zfs/workspaces/.mmi-pm-core}"
die(){ echo "provision-core: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "root requis (chown inter-utilisateur mathieu -> KARL_SUDO_USER)"
[ -d "$CORE_DIR/.git" ] || [ -f "$CORE_DIR/.git" ] || die "$CORE_DIR n'est pas un checkout git"
[ -f "$CORE_DIR/.env" ] || die "$CORE_DIR/.env absent — le placer (secrets) avant de verrouiller"

# Charger la config de l'instance (KARL_USER runtime, KARL_SUDO_USER propriétaire).
set -a; . "$CORE_DIR/.env"; set +a
: "${KARL_USER:?KARL_USER absent du .env}"
: "${KARL_SUDO_USER:?KARL_SUDO_USER absent du .env}"
id "$KARL_SUDO_USER" >/dev/null 2>&1 || die "user système '$KARL_SUDO_USER' inexistant"
id "$KARL_USER"      >/dev/null 2>&1 || die "user système '$KARL_USER' inexistant"

# Construire/rafraîchir l'index résolveur. On tourne en root → le gate sudo de mmi-pm
# est bypassé ; les symlinks créés (root) seront re-chownés par le verrou ci-dessous.
[ -x "$CORE_DIR/bin/mmi-pm" ] && "$CORE_DIR/bin/mmi-pm" index rebuild || die "bin/mmi-pm absent/inexécutable"

# Pré-requis d'appartenance : KARL_SUDO_USER (service PM) doit être membre du groupe
# KARL_USER pour LIRE .env (640 root:KARL_USER) et ÉCRIRE var/ (groupe). Idempotent ;
# root requis pour usermod (one-time bootstrap). Re-login requis pour prise d'effet, mais
# le verrou ci-dessous fixe déjà les bons propriétaires.
usermod -aG "$KARL_USER" "$KARL_SUDO_USER"

# Verrou de propriété : DÉLÉGUÉ à core-lock — SOURCE UNIQUE de la politique 3-couches
# (code=root ; .env=root:KARL_USER 640 ; var/=KARL_SUDO_USER:KARL_USER 2775 ; projects/=
# KARL_USER). On ne duplique JAMAIS le chown ici (RM2032).
[ -x "$CORE_DIR/scripts/core-lock" ] || die "scripts/core-lock absent/inexécutable"
"$CORE_DIR/scripts/core-lock" lock "$CORE_DIR"

echo "provision-core: $KARL_SUDO_USER ajouté au groupe $KARL_USER (lecture .env / écriture var/)"
echo "provision-core: instance verrouillée via core-lock (politique 3-couches, source unique)"
echo "provision-core: MAJ ultérieures -> 'sudo mmi-pm core update' (root, re-verrouille via core-lock)"
